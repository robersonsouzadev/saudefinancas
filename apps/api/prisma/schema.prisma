generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  name                  String?
  passwordHash          String?
  googleId              String?                @unique
  authProvider          String                 @default("LOCAL") // LOCAL, GOOGLE
  phone                 String?
  whatsappPhone         String?                @unique
  avatarUrl             String?
  role                  String                 @default("MEMBER") // ADMIN, MEMBER, VIEWER
  isActive              Boolean                @default(true)
  birthDate             DateTime?
  biologicalSex         BiologicalSex?
  heightCm              Float?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  conversations         Conversation[]
  healthLogs            HealthLog[]
  bodyMeasurements      BodyMeasurement[]
  mealLogs              MealLog[]
  healthGoals           HealthGoal[]
  financialAccounts     FinancialAccount[]
  transactions          Transaction[]
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]
  insightLogs           InsightLog[]
  dailySummaries        DailySummary[]
  familyMemberships     FamilyMember[]
  sentInvites           FamilyInvite[]         @relation("InviteSender")
  passwordResetCodes    PasswordResetCode[]
  investmentAssets      InvestmentAsset[]
  medications           Medication[]
  medicationLogs        MedicationIntakeLog[]
  labExams              LabExam[]
}

model FamilyGroup {
  id          String         @id @default(uuid())
  name        String
  description String?
  avatarUrl   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  members     FamilyMember[]
  invites     FamilyInvite[]
  budgets     FamilyBudget[]
}

model FamilyMember {
  id        String      @id @default(uuid())
  userId    String
  groupId   String
  role      String      @default("MEMBER") // ADMIN, MEMBER, VIEWER
  joinedAt  DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id])
  group     FamilyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

model FamilyInvite {
  id        String      @id @default(uuid())
  groupId   String
  invitedBy String
  email     String
  status    String      @default("PENDING") // PENDING, ACCEPTED, REJECTED, EXPIRED
  expiresAt DateTime
  createdAt DateTime    @default(now())
  group     FamilyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender    User        @relation("InviteSender", fields: [invitedBy], references: [id])
}

model PasswordResetCode {
  id        String    @id @default(uuid())
  userId    String
  code      String
  channel   String    @default("email") // "email" or "whatsapp"
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
}

model FamilyBudget {
  id          String             @id @default(uuid())
  groupId     String
  month       Int
  year        Int
  totalAmount Float
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  group       FamilyGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  allocations BudgetAllocation[]
}

model BudgetAllocation {
  id              String              @id @default(uuid())
  familyBudgetId  String
  categoryId      String
  percentage      Float
  allocatedAmount Float
  spentAmount     Float               @default(0)
  familyBudget    FamilyBudget        @relation(fields: [familyBudgetId], references: [id], onDelete: Cascade)
  category        TransactionCategory @relation(fields: [categoryId], references: [id])
}

model Agent {
  id                 String              @id @default(uuid())
  name               String
  description        String?
  systemPrompt       String
  modelName          String              @default("gpt-4o-mini")
  temperature        Float               @default(0.7)
  isDefault          Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  conversations      Conversation[]
  knowledgeDocuments KnowledgeDocument[]
}

model LlmProvider {
  id        String   @id @default(uuid())
  name      String
  provider  String?
  apiKey    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Conversation {
  id        String    @id @default(uuid())
  userId    String
  agentId   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id])
  agent     Agent     @relation(fields: [agentId], references: [id])
  messages  Message[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  content        String
  role           String // "user" or "assistant"
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
}

model WebhookConfig {
  id        String   @id @default(uuid())
  url       String
  secret    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KnowledgeDocument {
  id          String           @id @default(uuid())
  agentId     String?
  title       String
  fileType    String           @default("PDF")
  totalChunks Int              @default(1)
  content     String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  agent       Agent?           @relation(fields: [agentId], references: [id])
  chunks      KnowledgeChunk[]
}

model KnowledgeChunk {
  id         String                                @id @default(uuid())
  documentId String
  content    String
  chunkIndex Int                                   @default(0)
  embedding  Unsupported("vector(1536)")?
  document   KnowledgeDocument                     @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

enum BiologicalSex {
  MASCULINO
  FEMININO
}

model HealthLog {
  id       String   @id @default(uuid())
  userId   String
  type     String
  value    Float
  unit     String
  loggedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id])
}

model BodyMeasurement {
  id             String   @id @default(uuid())
  userId         String
  measuredAt     DateTime @default(now())

  // Composição corporal principal
  weightKg       Float?   // Peso em kg
  bodyFatPercent Float?   // % Gordura corporal

  // Circunferências (cm)
  waistCm        Float?   // Cintura
  hipCm          Float?   // Quadril
  chestCm        Float?   // Peito/Tórax
  neckCm         Float?   // Pescoço
  shoulderCm     Float?   // Ombros
  abdomenCm      Float?   // Abdômen

  // Membros superiores (cm)
  leftBicepCm    Float?   // Bíceps esquerdo
  rightBicepCm   Float?   // Bíceps direito
  leftForearmCm  Float?   // Antebraço esquerdo
  rightForearmCm Float?   // Antebraço direito

  // Membros inferiores (cm)
  leftThighCm    Float?   // Coxa esquerda
  rightThighCm   Float?   // Coxa direita
  leftCalfCm     Float?   // Panturrilha esquerda
  rightCalfCm    Float?   // Panturrilha direita

  notes          String?  // Observações livres

  user           User     @relation(fields: [userId], references: [id])

  createdAt      DateTime @default(now())

  @@index([userId, measuredAt])
}

model MealLog {
  id       String     @id @default(uuid())
  userId   String
  loggedAt DateTime   @default(now())
  items    MealItem[]
  user     User       @relation(fields: [userId], references: [id])
}

model MealItem {
  id        String  @id @default(uuid())
  mealLogId String
  name      String
  calories  Float?
  mealLog   MealLog @relation(fields: [mealLogId], references: [id])
}

model HealthGoal {
  id        String    @id @default(uuid())
  userId    String
  type      String
  target    Float
  deadline  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id])
}

model FinancialAccount {
  id           String        @id @default(uuid())
  userId       String
  name         String
  balance      Float         @default(0.0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]
}

model TransactionCategory {
  id           String             @id @default(uuid())
  name         String
  createdAt    DateTime           @default(now())
  transactions Transaction[]
  allocations  BudgetAllocation[]
}

model Transaction {
  id          String               @id @default(uuid())
  userId      String
  accountId   String
  categoryId  String?
  amount      Float
  date        DateTime             @default(now())
  description String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  user        User                 @relation(fields: [userId], references: [id])
  account     FinancialAccount     @relation(fields: [accountId], references: [id])
  category    TransactionCategory? @relation(fields: [categoryId], references: [id])
}

model Budget {
  id        String   @id @default(uuid())
  userId    String
  amount    Float
  period    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model RecurringTransaction {
  id        String   @id @default(uuid())
  userId    String
  amount    Float
  frequency String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model InsightLog {
  id        String   @id @default(uuid())
  userId    String
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model DailySummary {
  id      String   @id @default(uuid())
  userId  String
  date    DateTime @default(now())
  content String
  user    User     @relation(fields: [userId], references: [id])
}

model InvestmentAsset {
  id            String                  @id @default(uuid())
  userId        String
  broker        String                  @default("XP Investimentos")
  ticker        String
  name          String
  type          String                  // FII, ACAO, RENDA_FIXA, TESOURO, CRIPTO
  quantity      Float                   @default(0)
  totalInvested Float                   @default(0)
  currentPrice  Float?
  targetPercent Float                   @default(0)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  user          User                    @relation(fields: [userId], references: [id])
  transactions  InvestmentTransaction[]
}

model InvestmentTransaction {
  id          String          @id @default(uuid())
  assetId     String
  type        String          // BUY, SELL, DIVIDEND
  quantity    Float
  unitPrice   Float
  totalAmount Float
  date        DateTime        @default(now())
  asset       InvestmentAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════
// MEDICAMENTOS & VITAMINAS
// ═══════════════════════════════════════════

model Medication {
  id              String                @id @default(uuid())
  userId          String
  user            User                  @relation(fields: [userId], references: [id])
  name            String
  type            MedicationType        @default(MEDICAMENTO)
  category        MedicationCategory    @default(CONTINUO)
  priority        MedicationPriority    @default(IMPORTANTE)
  dosage          String
  unit            String
  instructions    String?
  currentStock    Int                   @default(0)
  stockAlertAt    Int                   @default(5)
  costPerUnit     Float?
  pharmacy        String?
  startDate       DateTime              @default(now())
  endDate         DateTime?
  isActive        Boolean               @default(true)
  color           String                @default("#5e6ad2")
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  schedules       MedicationSchedule[]
  intakeLogs      MedicationIntakeLog[]
}

model MedicationSchedule {
  id               String             @id @default(uuid())
  medicationId     String
  medication       Medication         @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  time             String
  windowMinutes    Int                @default(30)
  period           SchedulePeriod     @default(MANHA)
  frequency        ScheduleFrequency  @default(DIARIO)
  intervalHours    Int?
  weekDays         String?
  notifyWhatsapp   Boolean            @default(true)
  notifyPush       Boolean            @default(true)
  escalateToFamily Boolean            @default(false)
  escalateAfterMin Int                @default(45)
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
}

model MedicationIntakeLog {
  id             String       @id @default(uuid())
  medicationId   String
  medication     Medication   @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  scheduledAt    DateTime
  loggedAt       DateTime?
  status         IntakeStatus @default(PENDENTE)
  skipReason     String?
  whatsappSentAt DateTime?
  whatsappReadAt DateTime?
  respondedVia   String?
  createdAt      DateTime     @default(now())
}

enum MedicationType {
  MEDICAMENTO
  VITAMINA
  SUPLEMENTO
  FITOTERAPICO
}

enum MedicationCategory {
  CONTINUO
  TEMPORARIO
  SOS
}

enum MedicationPriority {
  CRITICO
  IMPORTANTE
  ROTINA
}

enum SchedulePeriod {
  MADRUGADA
  MANHA
  TARDE
  NOITE
}

enum ScheduleFrequency {
  DIARIO
  DIAS_ALTERNADOS
  SEMANAL
  INTERVALO_HORAS
}

enum IntakeStatus {
  PENDENTE
  TOMADO
  ATRASADO
  PULADO
}

// ═══════════════════════════════════════════
// EXAMES LABORATORIAIS & BIOMARCADORES
// ═══════════════════════════════════════════

model LabExam {
  id           String          @id @default(uuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id])
  title        String
  laboratory   String?
  examDate     DateTime        @default(now())
  sourceType   ExamSourceType  @default(PHOTO)
  originalFile String?
  aiProcessed  Boolean         @default(false)
  aiInsight    String?
  phenoAge     Float?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  results      LabResult[]
}

model LabResult {
  id            String            @id @default(uuid())
  examId        String
  exam          LabExam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  biomarkerKey  String
  biomarkerName String
  category      BiomarkerCategory @default(METABOLICO)
  value         Float
  unit          String
  referenceMin  Float?
  referenceMax  Float?
  optimalMin    Float?
  optimalMax    Float?
  status        BiomarkerStatus   @default(NORMAL)
  delta         Float?
  previousValue Float?
  createdAt     DateTime          @default(now())

  @@index([examId, biomarkerKey])
}

model BiomarkerReference {
  id           String            @id @default(uuid())
  key          String            @unique
  name         String
  category     BiomarkerCategory
  defaultUnit  String
  standardMin  Float?
  standardMax  Float?
  optimalMin   Float?
  optimalMax   Float?
  criticalLow  Float?
  criticalHigh Float?
  synonyms     String?
  description  String?
}

enum ExamSourceType {
  PHOTO
  PDF
  MANUAL
  WHATSAPP
}

enum BiomarkerCategory {
  HEMOGRAMA
  LIPIDIOS
  METABOLICO
  TIREOIDE
  HEPATICO
  RENAL
  VITAMINAS_MINERAIS
  HORMONIOS
  INFLAMACAO
  MARCADORES_TUMORAIS
  URINARIO
  OUTROS
}

enum BiomarkerStatus {
  CRITICO_BAIXO
  BAIXO
  NORMAL
  OTIMO
  ALTO
  CRITICO_ALTO
}


