+# ==============================================================================
+# TEMPLATE DE CONFIGURAÇÃO DE STAGING ISOLADO (VITA SAÚDE - G4.2)
+# ATENÇÃO: NUNCA preencha este arquivo com valores ou segredos de produção!
+# Copie para .env.staging na VPS e forneça senhas exclusivas de staging.
+# ==============================================================================
+
+NODE_ENV=staging
+APP_ENV=staging
+
+# Credenciais do PostgreSQL de Staging (Porta 5434 no host)
+STAGING_DB_NAME=vita_saude_staging
+STAGING_DB_USER=vita_staging_admin
+STAGING_DB_PASSWORD=gerar_senha_admin_staging_aqui
+STAGING_MIGRATOR_PASSWORD=gerar_senha_migrator_staging_aqui
+STAGING_APP_USER=vita_staging_app
+STAGING_APP_PASSWORD=gerar_senha_app_staging_aqui
+
+# Redis de Staging (Porta 6381 no host)
+REDIS_HOST=sf-redis-staging
+REDIS_PORT=6379
+
+# Filas BullMQ e Armazenamento LOCAL_SECURE
+QUEUE_NAME=wearables-fit-import-staging
+QUEUE_PREFIX=bull_staging
+STORAGE_PATH=/data/vita-saude-staging/wearables
+
+# Segredos Criptográficos Exclusivos de Staging
+STAGING_JWT_SECRET=gerar_chave_jwt_staging_min_32_chars_aqui
+STAGING_AUDIT_HMAC_SECRET=gerar_chave_hmac_staging_min_32_chars_aqui
+
+# Portas e Flags de Execução
+PORT=3001
+PUBLIC_API_URL=http://127.0.0.1:3011
+ALLOW_DESTRUCTIVE_TESTS=true
