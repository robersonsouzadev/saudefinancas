+
+def main():
+    parser = argparse.ArgumentParser(
+        description="Auditoria e Verificação Técnica Independente — Fase G4.2 V11"
+    )
+    parser.add_argument(
+        "--zip",
+        dest="zip_path",
+        default=None,
