+++static void compute_file_sha256(const char *filepath, char out_hex[65]) {
+++    sha256_ctx ctx;
+++    sha256_init(&ctx);
+++    FILE *f = fopen(filepath, "rb");
+++    if (!f) {
+++        strcpy(out_hex, "ERROR_OPENING_FILE");
