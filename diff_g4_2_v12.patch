++      } else {
++        isHealthy = false;
++        checks.database = 'DOWN';
++        errors.push('Database query returned empty result');
++      }
++    } catch (err: any) {
++      isHealthy = false;
++      checks.database = 'DOWN';
++      errors.push(`Database check failed: ${err?.message}`);
++    }
++
