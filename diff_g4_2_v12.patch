++echo "================================================================================"
++echo "INICIANDO SUÍTE FORMAL DE TESTES NEGATIVOS DO RUNNER (G4.2 V10)"
++echo "Target Runner: $TARGET_RUNNER"
++echo "Timestamp (UTC): $(date -u +'%Y-%m-%dT%H:%M:%SZ')"
++echo "================================================================================"
