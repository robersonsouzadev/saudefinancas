++    close(pipe_out[1]);
++    close(pipe_err[1]);
++
++    if (input_data && input_len > 0) {
++        size_t written = 0;
++        while (written < input_len) {
++            errno = 0;
++            ssize_t w = write(pipe_in[1], input_data + written, input_len - written);
++            if (w < 0) {
++                if (errno == EINTR) {
++                    continue;
++                }
++                if (errno == EPIPE) {
