+        help="Caminho da raiz do repositório (opcional)."
+    )
+    parser.add_argument(
+        "--evidence-out",
+        dest="evidence_out",
+        default=None,
+        help="Caminho do arquivo de evidência de saída (opcional)."
+    )
+
+    args = parser.parse_args()
