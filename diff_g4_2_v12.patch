+        }
+
+        close(pipe_wr[0]);
+        size_t off = 0;
+        while (off < c_size) {
+            size_t to_write = (c_size - off > 8192) ? 8192 : (c_size - off);
+            errno = 0;
+            ssize_t w = write(pipe_wr[1], c_payload + off, to_write);
+            if (w < 0) {
+                if (errno == EINTR) continue;
+                if (errno == EPIPE) break;
+                break;
+            }
+            if (w == 0) break;
+            off += (size_t)w;
+            usleep(200);
+        }
+        close(pipe_wr[1]);
+
+        int wr_status;
+        pid_t wr_wpid = waitpid(wr_pid, &wr_status, 0);
