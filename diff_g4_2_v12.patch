++    if (path_len >= sizeof(path_buf)) {
++        fprintf(stderr, "[SECURITY_ERROR] Caminho excede tamanho máximo suportado (4095).\n");
++        *out_exit_code = EXIT_ERR_SECURITY;
++        return -1;
++    }
++    memcpy(path_buf, rel_path, path_len + 1);
