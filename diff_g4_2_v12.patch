+
+  it('6. Deve redigir buffers binários e sequências hexadecimais longas', () => {
+    const rawBuffer = `Conteúdo binário recebido: ${canaryValues.binaryBuffer}`;
+    const redactedBuffer = service.redact(rawBuffer);
