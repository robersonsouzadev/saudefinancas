+++    }
+++    out_hex[64] = '\0';
+++}
+++
+++static void compute_buffer_sha256(const uint8_t *data, size_t len, char out_hex[65]) {
+++    sha256_ctx ctx;
+++    sha256_init(&ctx);
+++    sha256_update(&ctx, data, len);
+++    uint8_t hash[32];
+++    sha256_final(&ctx, hash);
+++    for (int i = 0; i < 32; i++) {
+++        sprintf(out_hex + (i * 2), "%02x", hash[i]);
+++    }
+++    out_hex[64] = '\0';
+++}
