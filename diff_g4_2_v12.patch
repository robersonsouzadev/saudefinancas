+++#ifndef _GNU_SOURCE
+++#define _GNU_SOURCE
+++#endif
+++
+++#include <stdio.h>
+++#include <stdlib.h>
+++#include <string.h>
+++#include <fcntl.h>
+++#include <unistd.h>
+++#include <sys/stat.h>
+++#include <sys/syscall.h>
+++#include <sys/types.h>
+++#include <errno.h>
+++#include <stdint.h>
+++#include <time.h>
+++#include <signal.h>
