++
++    size_t total_out = 0;
++    if (out_buf && out_buf_len > 0) {
++        ssize_t r;
++        while ((r = read(pipe_out[0], out_buf + total_out, out_buf_len - 1 - total_out)) > 0) {
++            total_out += (size_t)r;
++        }
++        out_buf[total_out] = '\0';
++    }
++    close(pipe_out[0]);
++
++    size_t total_err = 0;
++    if (err_buf && err_buf_len > 0) {
++        ssize_t r;
++        while ((r = read(pipe_err[0], err_buf + total_err, err_buf_len - 1 - total_err)) > 0) {
++            total_err += (size_t)r;
++        }
++        err_buf[total_err] = '\0';
++    }
++    close(pipe_err[0]);
