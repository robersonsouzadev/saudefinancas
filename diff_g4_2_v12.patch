++    } catch (err: any) {
++      this.probeResult = {
++        status: 'error',
++        openat2: false,
++        renameat2_noreplace: false,
++        proc_self_fd: false,
++        exitCode: 1,
++        rawStderr: err.message,
++      };
++      return this.probeResult;
++    }
