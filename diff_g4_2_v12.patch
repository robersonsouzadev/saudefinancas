++def sha256_file(filepath):
++    import hashlib
++    h = hashlib.sha256()
++    with open(filepath, 'rb') as f:
++        while chunk := f.read(65536):
++            h.update(chunk)
++    return h.hexdigest()
++
++def main():
++    script_dir = Path(__file__).resolve().parent
