++
++    // 7. Fragmentos binários ou hexadecimais longos (> 64 caracteres)
++    str = str.replace(/<Buffer(?:\s+[0-9a-f]{2})+(\s*\.\.\.\s*\d+\s*more\s*bytes)?>/gi, '[REDACTED_BUFFER]');
