+static void *unlink_attacker_worker(void *arg) {
+    unlink_attacker_args_t *args = (unlink_attacker_args_t *)arg;
+    args->thread_id = pthread_self();
+
+    char sync_buf[512];
+    ssize_t sn_r;
+    while ((sn_r = read(args->pipe_sync_fd, sync_buf, sizeof(sync_buf) - 1)) > 0) {
