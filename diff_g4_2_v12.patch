+++    }
+++    fclose(f);
+++    uint8_t hash[32];
+++    sha256_final(&ctx, hash);
+++    for (int i = 0; i < 32; i++) {
+++        sprintf(out_hex + (i * 2), "%02x", hash[i]);
+++    }
+++    out_hex[64] = '\0';
+++}
